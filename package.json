{
	"name": "esr",
	"private": true,
	"version": "0.0.1",
	"packageManager": "pnpm@11.1.3",
	"type": "module",
	"scripts": {
		"dev:desktop": "pnpm --config.verify-deps-before-run=false --filter desktop dev",
		"dev:cloud": "pnpm --config.verify-deps-before-run=false --filter cloud dev",
		"build:desktop": "pnpm --config.verify-deps-before-run=false --filter desktop build",
		"build:cloud": "pnpm --config.verify-deps-before-run=false --filter cloud build",
		"db:postgres:migrate": "pnpm --config.verify-deps-before-run=false --filter @esr/db-postgres migrate",
		"db:postgres:seed": "pnpm --config.verify-deps-before-run=false --filter @esr/db-postgres seed",
		"db:postgres:test": "pnpm --config.verify-deps-before-run=false --filter @esr/db-postgres test:integration",
		"lint": "pnpm --config.verify-deps-before-run=false -r lint",
		"check": "pnpm --config.verify-deps-before-run=false -r check",
		"test": "pnpm --config.verify-deps-before-run=false --filter @esr/core test && pnpm --config.verify-deps-before-run=false --filter @esr/db-sqlite test",
		"dev": "pnpm --config.verify-deps-before-run=false --filter desktop dev",
		"build": "pnpm --config.verify-deps-before-run=false --filter desktop build",
		"build:electron": "pnpm --config.verify-deps-before-run=false --filter desktop build:electron",
		"preview": "pnpm --config.verify-deps-before-run=false --filter desktop preview",
		"prepare": "echo \"root workspace ready\""
	}
}
