{
	"name": "@esr/db-postgres",
	"private": true,
	"version": "0.0.1",
	"description": "PostgreSQL data access for ESR Cloud.",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"types": "./src/index.ts",
	"scripts": {
		"migrate": "tsx src/migrate.ts",
		"seed": "tsx src/seed.ts",
		"test:integration": "tsx src/integration-test.ts",
		"lint": "echo \"db-postgres lint pending\"",
		"check": "tsc --noEmit -p tsconfig.json",
		"check:tenant": "node scripts/check-tenant-scope.cjs"
	},
	"dependencies": {
		"@esr/core": "workspace:*",
		"@esr/schemas": "workspace:*",
		"bcryptjs": "^3.0.2",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^26.0.0",
		"@types/pg": "^8.15.6",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	}
}
