{
	"name": "desktop",
	"private": true,
	"version": "0.0.1",
	"description": "ESR Pro desktop/offline app.",
	"type": "module",
	"main": "electron/main.cjs",
	"scripts": {
		"dev:svelte": "vite dev --port 5175",
		"dev:electron": "electron .",
