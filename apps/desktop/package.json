		"electron": "^41.0.3",
		"electron-builder": "^26.8.1",
		"electron-is-dev": "^3.0.1",
		"npm-run-all": "^4.1.5",
		"sqlite3": "^6.0.1",
		"svelte": "^5.51.0",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@esr/core": "workspace:*",
		"@esr/db-sqlite": "workspace:*",
